#!/bin/bash -l
#PBS -N flame_multinode
#PBS -l select=2:ncpus=64:ngpus=4
#PBS -l walltime=02:00:00
#PBS -l filesystems=home:eagle
#PBS -q debug-scaling
#PBS -A datascience
#PBS -o flame_multinode.out
#PBS -e flame_multinode.err

# ============================================================================
# Polaris Multi-Node Multi-GPU Training Script for Flame
# ============================================================================
# Polaris specs: 4 NVIDIA A100 GPUs per node, AMD EPYC Milan CPU
# This script supports distributed training across multiple nodes
# ============================================================================

# Move to the working directory
cd $PBS_O_WORKDIR

# Get job information
NNODES=$(wc -l < $PBS_NODEFILE)
NGPUS_PER_NODE=4
NTOTRANKS=$((NNODES * NGPUS_PER_NODE))

echo "=============================================="
echo "Job Information"
echo "=============================================="
echo "PBS Job ID: $PBS_JOBID"
echo "Number of nodes: $NNODES"
echo "GPUs per node: $NGPUS_PER_NODE"
echo "Total MPI ranks: $NTOTRANKS"
echo "Node list:"
cat $PBS_NODEFILE
echo "=============================================="

# Set proxy for network access (needed for HuggingFace downloads)
export http_proxy="http://proxy.alcf.anl.gov:3128"
export https_proxy="http://proxy.alcf.anl.gov:3128"

# Load required modules
module use /soft/modulefiles
module load conda

# Activate the virtual environment
source /lus/eagle/projects/datascience/vsastry/projects/LinearAttention/venvs/flame_env/bin/activate

# Set the master address to the first node
MASTER_ADDR=$(head -n 1 $PBS_NODEFILE)
MASTER_PORT=29500

export MASTER_ADDR
export MASTER_PORT

echo "Master node: $MASTER_ADDR:$MASTER_PORT"

# NCCL and distributed training settings
export NCCL_DEBUG=WARN
export NCCL_COLLNET_ENABLE=0
export NCCL_NET_GDR_LEVEL=PHB

# PyTorch memory settings
export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

# Temporary directory
export TMPDIR=/tmp/$USER
mkdir -p $TMPDIR

# Disable wandb for now (enable if needed)
export WANDB_MODE=disabled

# Create output directory on shared filesystem (Eagle)
# IMPORTANT: Use Eagle filesystem for checkpoints as it's accessible from all nodes
DUMP_FOLDER="/lus/eagle/projects/datascience/vsastry/projects/LinearAttention/flame_exp/gla-340M-polaris-multinode"
mkdir -p $DUMP_FOLDER

# ============================================================================
# Training Configuration
# ============================================================================
CONFIG_FILE="flame/models/fla.toml"
MODEL_CONFIG="configs/gla_340M.json"
TOKENIZER_PATH="fla-hub/transformer-1.3B-100B"

# Launch distributed training with mpiexec
# --ppn: processes (MPI ranks) per node (4 = one per GPU)
# --depth: hardware threads per rank
# --cpu-bind: CPU binding strategy
mpiexec -n ${NTOTRANKS} --ppn ${NGPUS_PER_NODE} --depth=8 --cpu-bind depth \
    ./set_affinity_gpu_polaris.sh python -m flame.train \
    --job.config_file ${CONFIG_FILE} \
    --job.dump_folder ${DUMP_FOLDER} \
    --model.config ${MODEL_CONFIG} \
    --model.tokenizer_path ${TOKENIZER_PATH} \
    --optimizer.name AdamW \
    --optimizer.eps 1e-15 \
    --optimizer.lr 1e-3 \
    --lr_scheduler.warmup_steps 1024 \
    --lr_scheduler.lr_min 0.1 \
    --lr_scheduler.decay_type cosine \
    --training.batch_size 1 \
    --training.seq_len 65536 \
    --training.context_len 4096 \
    --training.varlen \
    --training.gradient_accumulation_steps 1 \
    --training.steps 20480 \
    --training.max_norm 1.0 \
    --training.skip_nan_inf \
    --training.dataset HuggingFaceFW/fineweb-edu \
    --training.dataset_name sample-100BT \
    --training.dataset_split train \
    --training.num_workers 8 \
    --training.prefetch_factor 2 \
    --training.seed 42 \
    --training.compile \
    --checkpoint.interval 2048 \
    --checkpoint.load_step -1 \
    --checkpoint.keep_latest_k 2 \
    --metrics.log_freq 1

echo "=============================================="
echo "Training completed!"
echo "=============================================="
